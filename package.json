{
  "name": "aicd-workspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "local": "node --experimental-strip-types scripts/local.mjs",
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node --experimental-strip-types scripts/local.mjs",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/runtime-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/prepare-assets.mjs",
    "dev:standalone": "node scripts/standalone.mjs dev",
    "build:standalone": "node scripts/standalone.mjs build",
    "check:standalone": "node scripts/standalone.mjs dry-run",
    "deploy:standalone": "node scripts/standalone.mjs deploy",
    "export:source": "python3 scripts/export-source.py"
  },
  "dependencies": {
    "@hyzyla/pdfium": "3.0.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "postal-mime": "^2.5.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "word-extractor": "1.0.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
