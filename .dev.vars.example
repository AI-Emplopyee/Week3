# Copy to .dev.vars for local development only. This example contains no credentials.
# Never prefix secrets with VITE_ or NEXT_PUBLIC_. Never commit the populated file.
AICD_AUTH_MODE="supabase"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
AICD_OWNER_EMAIL=""

# Optional owner-configured GLM extraction. The key enables paid processing.
# For npm run local, edit .aicd-local/.dev.vars instead: this root file is ignored.
# The API endpoint is fixed to https://api.z.ai/api/paas/v4 by server code.
ZAI_API_KEY=""
# The live application supports GLM-5.3-Flash only, with low reasoning effort.
ZAI_MODEL="glm-5.3-flash"
